{
  "expo": {
    "name": "PIH Pulse",
    "slug": "PIH-PULSE",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pihpulse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ben229.PIHPULSE",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PIH Pulse a besoin d’accéder à ta galerie pour les photos de profil et les médias de projets.",
        "NSCameraUsageDescription": "PIH Pulse peut utiliser l’appareil photo pour ta photo de profil.",
        "NSMicrophoneUsageDescription": "Nécessaire uniquement si tu enregistres une vidéo.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0B05",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ben229.PIHPULSE",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0D0B05"
          },
          "backgroundColor": "#F8F5EC",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorise PIH Pulse à accéder à tes photos pour le profil et les posts.",
          "cameraPermission": "Autorise PIH Pulse à utiliser la caméra pour ta photo de profil."
        }
      ],
      "expo-image",
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0D0B05",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08e66b61-f9d2-4951-aef5-d6e62f60f922"
      }
    },
    "owner": "ben229"
  }
}
